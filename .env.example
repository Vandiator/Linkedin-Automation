# ──────────────────────────────────────────────────────────────────────
# LinkedIn Auto-Poster — environment variables
# Copy this file to `.env` and fill in your real values.
# Never commit `.env` to GitHub. Add the same values as GitHub Secrets
# (repo → Settings → Secrets and variables → Actions) so the weekly
# workflow can run.
# ──────────────────────────────────────────────────────────────────────

# ─── Cloudinary (image + PDF hosting) — REQUIRED ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local gallery server port (only used by gallery.js)
PORT=3000

# Optional: Cloudinary auto-tagging add-on
CLOUDINARY_AUTOTAG_PROVIDER=
CLOUDINARY_AUTOTAG_CONFIDENCE=0.6

# ─── Groq (content generation, free) — REQUIRED ───────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# ─── Buffer (LinkedIn scheduling) — REQUIRED ──────────────────────────
# Generate at https://publish.buffer.com/settings/api
BUFFER_API_TOKEN=
LINKEDIN_CHANNEL_ID=

# ─── Pollinations.ai (image generation, free, no key) — OPTIONAL ──────
# Pollinations is keyless by default. Only set this if you have a token
# from https://auth.pollinations.ai for higher rate limits.
POLLINATIONS_TOKEN=

# ─── Hugging Face (image generation fallback) — OPTIONAL ──────────────
# Used only if Pollinations is unavailable. Get a free key at
# https://huggingface.co/settings/tokens (Read access is enough).
HF_API_KEY=
